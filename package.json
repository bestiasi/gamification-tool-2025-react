{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --dir src",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gt-2025 \"vitest run --dir tests/rules\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-gt-2025 \"playwright test\""
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.54.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.11.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
